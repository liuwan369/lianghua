[Unit]
Description=Polymarket BTC 5m simple trading dashboard (Tokyo, local only)
After=network-online.target pm-r25-tokyo-collector.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system
Environment=PYTHONUNBUFFERED=1
Environment=PM_TOKYO_LIVE_LOCAL=1
Environment=TOKYO_LIVE_URL=http://127.0.0.1:18766/api/live
ExecStart=/usr/bin/python3 /root/pm-system/scripts/system-dashboard-server.py --host 127.0.0.1 --port 18766 --root /root/pm-system
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system

[Install]
WantedBy=multi-user.target
