[Unit]
# Stop restarting after 20 failures in 5 minutes (a broken release looped forever).
StartLimitIntervalSec=300
StartLimitBurst=20
Description=Polymarket binance-lead console (Ireland, local only; nginx in front)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system
Environment=PYTHONUNBUFFERED=1
Environment=PM_NODE_LABEL=爱尔兰
Environment=PM_ACCOUNT_PROFILE=/root/.config/pm-system/account.json
# Operator file, never in git: PM_TRADING_LIVE_UNLOCK, PM_TRUST_ACCOUNT_PROXY=1,
# PM_ACCOUNT_PUBLIC_ORIGIN, PM_ACCOUNT_RPC_URL(_FALLBACK_URL) and the engine's
# PM_RELAY_* (key file path, port, allowed source). The engine inherits them.
EnvironmentFile=/root/.config/pm-system/console.env
ExecStart=/usr/bin/python3 /root/pm-system/scripts/system-dashboard-server.py --host 127.0.0.1 --port 18766 --root /root/pm-system
Restart=always
RestartSec=3
# The console (HTTP, push, account bridge, projection worker) yields to the
# engine on a 2-vCPU box. The engine is not under these settings: it runs in
# its own transient scope (pm-engine-<run_id>, system.slice) with CPUWeight=200
# and Nice -5 (scripts/system-dashboard-server.py _engine_scope_args), so
# neither these limits nor a restart or OOM kill of this unit reach it (BUGS O2).
Nice=10
CPUWeight=20
# IOWeight is a cgroup setting, so the engine's scope does not get it; a
# per-process IOSchedulingClass would be inherited by the engine, so none is set.
IOWeight=20
MemoryMax=350M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system
ReadWritePaths=-/root/.config/pm-system

[Install]
WantedBy=multi-user.target
