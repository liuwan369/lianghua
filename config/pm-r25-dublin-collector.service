[Unit]
Description=Polymarket BTC 5m Dublin read-only evidence collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system
ExecStart=/root/pm-system/.venv/bin/python /root/pm-system/scripts/pm-r25-tokyo-evidence-collector.py --config /root/pm-system/config/pm-r25-dublin-collector.json
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system/data
MemoryMax=768M
CPUQuota=180%

[Install]
WantedBy=multi-user.target
