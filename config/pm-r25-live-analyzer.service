[Unit]
Description=Analyze rolling Tokyo Polymarket evidence
After=pm-r25-tokyo-collector.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/pm-system
ExecStart=/usr/bin/python3 /root/pm-system/scripts/pm-r25-live-evidence-analysis.py --db /root/pm-system/data/pm-r25-live/tokyo-evidence.sqlite3 --hours 24 --out /root/pm-system/data/pm-r25-live/live-analysis.json
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system/data
MemoryMax=512M
CPUQuota=100%
