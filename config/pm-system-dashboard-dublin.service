[Unit]
# Stop restarting after 20 failures in 5 minutes (a broken release looped forever).
StartLimitIntervalSec=300
StartLimitBurst=20
Description=Polymarket BTC 5m simple trading dashboard (Dublin, local only)
After=network-online.target pm-clob-market-snapshot.service
Wants=network-online.target pm-clob-market-snapshot.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system
Environment=PYTHONUNBUFFERED=1
Environment=PM_NODE_LABEL=都柏林节点
Environment=PM_TRUST_ACCOUNT_PROXY=1
Environment=PM_ACCOUNT_PROFILE=/root/.config/pm-system/account.json
Environment=PM_LIVE_LOCAL=1
Environment=PM_COLLECTOR_SERVICE=pm-clob-market-snapshot.service
Environment=PM_MARKET_SNAPSHOT_PATH=/root/pm-system/data/dashboard/market-snapshot.json
Environment=PM_LIVE_URL=http://127.0.0.1:18766/api/live
Environment=POLYMARKET_WALLET_ADDRESS=0xA693a0E0e40BDeC3d9d4a40bD4D087A5cECFD7cd
EnvironmentFile=-/root/pm-system/config/dashboard-secret.env
ExecStart=/usr/bin/python3 /root/pm-system/scripts/system-dashboard-server.py --host 127.0.0.1 --port 18766 --root /root/pm-system
Restart=always
RestartSec=3
# The trading engine runs in its own systemd scope (pm-engine-<run_id>), so
# neither this limit nor a restart of this unit reaches it (BUGS O2). A leak
# here must not push the box into a global OOM.
MemoryMax=900M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system
ReadWritePaths=-/root/.config/pm-system

[Install]
WantedBy=multi-user.target
