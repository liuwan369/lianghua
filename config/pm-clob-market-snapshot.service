[Unit]
Description=Polymarket public CLOB Market WebSocket snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system/_external/btc-5m-market-trading-bot
ExecStart=/usr/local/bin/node /root/pm-system/_external/btc-5m-market-trading-bot/dist/cli/market-snapshot.js --output /root/pm-system/data/dashboard/market-snapshot.json
Restart=always
RestartSec=1
Environment=NODE_ENV=production
Environment=PM_MARKET_SNAPSHOT_STALE_MS=2000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system/data/dashboard
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
