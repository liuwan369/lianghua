# Environment read by the engine (backend/engine/src) and the control plane (scripts/).
# Placeholders only. Never commit real credentials. When uncommenting a line,
# drop the trailing "# ..." note so it is not read as part of the value.

# ---- Required account vars ----
# Funding (deposit) wallet address.
POLYMARKET_WALLET_ADDRESS=0xYOUR_DEPOSIT_WALLET
# Owner signer key for the deposit wallet.
POLYMARKET_OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY
# POLYMARKET_SESSION_PRIVATE_KEY=0xYOUR_SESSION_KEY      # optional session signer key
# POLYMARKET_PRIVATE_KEY=0xYOUR_KEY                      # legacy owner key, used only if the OWNER key is unset
# RELAYER_API_KEY=replace-me                             # relayer key for settlement
# RELAYER_API_KEY_ADDRESS=0xRELAYER_ADDRESS              # address bound to the relayer key
# POLY_BUILDER_API_KEY=replace-me                        # builder key (alternative settlement path)
# POLY_BUILDER_SECRET=replace-me                         # builder secret
# POLY_BUILDER_PASSPHRASE=replace-me                     # builder passphrase

# ---- Optional overrides: engine ----
# POLY_FUNDER=0xYOUR_DEPOSIT_WALLET                      # override auto-detected funder
# POLY_SIGNATURE_TYPE=3                                  # override auto-detected signature type
# CLOB_HOST=https://clob.polymarket.com                  # CLOB REST endpoint
# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com     # Polygon RPC for trading/settlement reads
# PM_ACCOUNT_RPC_URL=https://polygon-rpc.example         # RPC for account checks
# PM_ACCOUNT_RPC_FALLBACK_URL=https://polygon-rpc.example # fallback RPC for account checks
# PM_ACCOUNT_HISTORY_DIR=results/account-history         # account history directory
# PM_FINANCE_SCAN_FROM_BLOCK=0                           # first block of the funding-flow scan
# PM_FINANCE_CONFIRMATIONS=12                            # confirmations before a flow counts
# PM_FINANCE_SCAN_CHUNK_SIZE=5000                        # blocks per funding-flow scan request
# PM_ATOMIC_ACCOUNT_URL=https://provider.example/snap    # optional atomic account snapshot source
# PM_ATOMIC_ACCOUNT_BEARER_TOKEN=replace-me              # bearer token for that source
# PM_BLOCKED_OWNER_ADDRESSES=0xA,0xB                     # owner addresses the account check refuses
# PM_LIVE_URL=http://127.0.0.1:18766/api/live            # local market collector endpoint for discovery
# PM_REFERENCE_ASSETS=btc,eth                            # restrict reference price feeds to these assets
# PM_TRACE=1                                             # market feed diagnostics

# ---- Optional overrides: control plane (scripts/) ----
# PM_DASHBOARD_CONTROL_TOKEN=replace-me                  # bootstrap control token
# PM_TRADING_LIVE_UNLOCK=1                               # allow live trading starts
# PM_CONTROL_SESSION_TTL_SECONDS=43200                   # control session lifetime
# PM_CONTROL_COOKIE_SECURE=1                             # force Secure on the control cookie
# PM_TRUST_ACCOUNT_PROXY=1                               # trust the HTTPS reverse proxy
# PM_ACCOUNT_PUBLIC_ORIGIN=https://dashboard.example     # public origin for control requests
# PM_ACCOUNT_PROFILE=~/.config/pm-system/account.json    # saved account profile path
# PM_ACCOUNT_NODE_COMPILE_CACHE=/var/cache/pm-node       # NODE_COMPILE_CACHE for account checks
# PM_NODE_LABEL=node-name                                # node label shown in the dashboard
# PM_LIVE_LOCAL=1                                        # market collector runs on this host
# PM_MARKET_SNAPSHOT_PATH=data/dashboard/market-snapshot.json # local market snapshot file
# PM_COLLECTOR_SERVICE=pm-clob-market-snapshot.service   # collector systemd unit
# PM_REMOTE_HOST=root@collector.example                  # remote collector SSH host
# PM_REMOTE_PORT=22                                      # remote collector SSH port
# PM_REMOTE_CONNECT_TIMEOUT=5                            # remote SSH connect timeout (seconds)
# PM_REMOTE_SSH_KEY=~/.ssh/id_ed25519                    # remote SSH key path
# PM_REMOTE_SNAPSHOT_PATH=/path/market-snapshot.json     # remote market snapshot file
