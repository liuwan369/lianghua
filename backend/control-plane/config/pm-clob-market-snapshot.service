[Unit]
Description=Polymarket public CLOB Market WebSocket snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pm-system/backend/engine
ExecStart=/usr/local/bin/node /root/pm-system/backend/engine/dist/cli/market-snapshot.js --assets btc,eth,sol --output /root/pm-system/data/dashboard/market-snapshot.json --stale-after-ms 2000
Restart=always
RestartSec=1
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/pm-system/data/dashboard
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
