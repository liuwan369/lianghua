# =============================================================================
# Polymarket BTC 5m Maker Bot — environment template (CLOB V2 / pUSD)
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git (see .gitignore).
#
# Collateral is pUSD (not raw USDC.e). Deposits via polymarket.com auto-wrap.
# API-only: `node dist/cli/live.js wrap --broadcast --amount-usd 10`
# Docs: https://docs.polymarket.com/concepts/pusd
#
# Use a DEDICATED wallet funded only with what you can afford to lose.
# =============================================================================

# -----------------------------------------------------------------------------
# Wallet & authentication (required for LIVE trading only)
# -----------------------------------------------------------------------------

# Deposit Wallet shown by Polymarket. This is public and is not a private key.
POLYMARKET_WALLET_ADDRESS=0xYOUR_DEPOSIT_WALLET

# Owner key exported from the email/Magic account. Never send it in chat or
# upload it to Git. The legacy POLYMARKET_PRIVATE_KEY name is still accepted.
POLYMARKET_OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY

# Session Key is intentionally separate from the Owner key. Leave blank until
# Polymarket grants management access and the Session Key adapter is enabled.
# POLYMARKET_SESSION_PRIVATE_KEY=0xYOUR_SESSION_PRIVATE_KEY

# Wallet type and trading address are AUTO-DETECTED at startup:
#   1. Gamma API  → proxyWallet for your EOA (polymarket.com public profile)
#   2. On-chain   → signature type via Gnosis Safe getOwners() / ERC-1271 checks
#      (same method as Polymarket CLOB SDK — types 0 EOA, 1 proxy, 2 Safe, 3 deposit)
#
# Optional manual overrides (required for many new V2 accounts):
# POLY_FUNDER is a legacy alias for POLYMARKET_WALLET_ADDRESS.
# POLY_FUNDER=0xYourDepositWalletFromPolymarketSettings
# POLY_SIGNATURE_TYPE=3

# Relayer credentials pay gas for wallet operations; they do not sign orders.
# RELAYER_API_KEY=...
# RELAYER_API_KEY_ADDRESS=0x...

# Builder credentials are only for approved Builder integrations. They are
# not required for a self-hosted bot and are not the account's order-signing key.
# POLY_BUILDER_API_KEY=...
# POLY_BUILDER_SECRET=...
# POLY_BUILDER_PASSPHRASE=...

# -----------------------------------------------------------------------------
# Execution mode
# -----------------------------------------------------------------------------

# false = PAPER (default, safe): logs orders, simulates fills from the book.
# true  = LIVE: submits REAL orders; fills from CLOB user WebSocket.
# The `run` command also accepts --live / --paper flags (they override this).
LIVE=false

# -----------------------------------------------------------------------------
# Order size & kill switches (used by `run` when flags not passed)
# -----------------------------------------------------------------------------

# Max USD notional per order. Polymarket minimum is ~5 shares (~$2–3 at 0.40–0.50).
# START TINY. Scale up only after confirmed live fills.
MAX_ORDER_USD=2

# Max number of orders submitted per bot session (hard stop).
MAX_ORDERS=50

# Cumulative notional cap for the session (strongly recommended for first live runs).
MAX_TOTAL_USD=10

# -----------------------------------------------------------------------------
# Network (optional — defaults work for most users)
# -----------------------------------------------------------------------------

# Polygon JSON-RPC for wallet reads, approve, settle, and CLOB signing.
# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

# Polymarket CLOB REST host (change only if Polymarket updates endpoints).
# CLOB_HOST=https://clob.polymarket.com

# -----------------------------------------------------------------------------
# Strategy / feed tuning (optional — CLI flags override these)
# -----------------------------------------------------------------------------

# Strategy heartbeat interval in milliseconds.
# HEARTBEAT_MS=50

# Re-run strategy when BTC moves at least this many basis points (0 = every book tick).
# BTC_MOVE_BPS=0

# REST order-book poll rate in Hz (0 = WebSocket only).
# BOOK_POLL_HZ=0

# Cancel resting quotes if BTC moves against the quote by this many bps (0 = off).
# DEFENSIVE_CANCEL_BPS=0

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------

# Webhook URL for `monitor` alerts (Slack incoming webhook, Discord, etc.).
# MONITOR_WEBHOOK=https://hooks.slack.com/services/...

# -----------------------------------------------------------------------------
# Debug (optional — set to any value to enable verbose feed logging)
# -----------------------------------------------------------------------------

# BTC_TRACE=1
# PM_TRACE=1
# RTDS_TRACE=1
