# BTC five-minute reversal platform environment template
# Copy to .env only for local development. Never commit real credentials.

# Required account identity for authenticated trading.
POLYMARKET_WALLET_ADDRESS=0xYOUR_DEPOSIT_WALLET
POLYMARKET_OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY

# Optional wallet override. Leave unset when automatic detection is correct.
# POLY_FUNDER=0xYOUR_DEPOSIT_WALLET
# POLY_SIGNATURE_TYPE=3

# Network endpoints. Public defaults are used when these are unset.
# CLOB_HOST=https://clob.polymarket.com
# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# PM_ACCOUNT_RPC_URL=https://polygon-bor-rpc.publicnode.com
# PM_ACCOUNT_RPC_FALLBACK_URL=https://polygon-rpc.com

# Optional account history and confirmed funding-flow scan settings.
# PM_ACCOUNT_HISTORY_DIR=results/account-history
# PM_FINANCE_SCAN_FROM_BLOCK=0
# PM_FINANCE_CONFIRMATIONS=12
# PM_FINANCE_SCAN_CHUNK_SIZE=5000

# Optional provider-owned atomic account source. The platform works without it
# and reports the available consistency scope instead of inventing a snapshot.
# PM_ATOMIC_ACCOUNT_URL=https://provider.example/account-snapshot
# PM_ATOMIC_ACCOUNT_BEARER_TOKEN=replace-me

# Optional relayer or builder credentials for supported settlement paths.
# RELAYER_API_KEY=replace-me
# RELAYER_API_KEY_ADDRESS=0xRELAYER_ADDRESS
# POLY_BUILDER_API_KEY=replace-me
# POLY_BUILDER_SECRET=replace-me
# POLY_BUILDER_PASSPHRASE=replace-me

# Diagnostics only. These do not change strategy timing or sampling.
# BTC_TRACE=1
# PM_TRACE=1
# RTDS_TRACE=1

# Trading always starts through dist/cli/platform.js --live with a saved
# btc-reversal configuration. There is no paper or legacy maker start mode.
